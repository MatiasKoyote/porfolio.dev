---
const personalImageAlt = "Matías Santis Urzúa"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-2xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/mati.png"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/matias-santis-urzua/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Abierto a nuevas oportunidades</Badge>
    </a>
  </div>

  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hola, soy Matías 👋
  </h1>

  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    <strong>Automation Engineer</strong> con más de 6 años de experiencia
    construyendo y evolucionando soluciones de automatización empresarial.
    Trabajo principalmente con UiPath, Python, APIs e integraciones.
  </p>

  <p class="mt-4 text-lg text-gray-700 dark:text-gray-400">
    Me gusta moverme entre automatización, desarrollo e infraestructura:
    entender un problema, diseñar una solución y dejarla funcionando de forma
    simple, mantenible y observable.
  </p>

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:msantisurzua@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/matias-santis-urzua/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
